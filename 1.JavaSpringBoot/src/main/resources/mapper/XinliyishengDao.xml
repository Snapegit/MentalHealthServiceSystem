<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cl.dao.XinliyishengDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.cl.entity.XinliyishengEntity" id="xinliyishengMap">
        <result property="yishengzhanghao" column="yishengzhanghao"/>
        <result property="yishengmima" column="yishengmima"/>
        <result property="yishengxingming" column="yishengxingming"/>
        <result property="zhaopian" column="zhaopian"/>
        <result property="xingbie" column="xingbie"/>
        <result property="lianxidianhua" column="lianxidianhua"/>
        <result property="sfsh" column="sfsh"/>
        <result property="shhf" column="shhf"/>
    </resultMap>

    <select id="selectListView"
		resultType="com.cl.entity.view.XinliyishengView" >

		SELECT  xinliyisheng.* FROM xinliyisheng  xinliyisheng 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.cl.entity.view.XinliyishengView" >
		SELECT * FROM xinliyisheng  xinliyisheng <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectGroupBy"
		resultType="com.cl.entity.view.XinliyishengView" >
		select userid,username,paperid,papername,sum(myscore) myscore,ROUND(sum(case when myscore>0 then 1 else 0 end)/(sum(1)),2) accuracy from examrecord     
        <where> 1=1 ${ew.sqlSegment}</where>
        group by userid,username,paperid,papername  
	</select>

</mapper>
