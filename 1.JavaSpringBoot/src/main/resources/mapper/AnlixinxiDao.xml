<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cl.dao.AnlixinxiDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.cl.entity.AnlixinxiEntity" id="anlixinxiMap">
        <result property="anlimingcheng" column="anlimingcheng"/>
        <result property="tupian" column="tupian"/>
        <result property="anlileixing" column="anlileixing"/>
        <result property="anlishipin" column="anlishipin"/>
        <result property="anlixiangqing" column="anlixiangqing"/>
        <result property="fabushijian" column="fabushijian"/>
        <result property="storeupnum" column="storeupnum"/>
    </resultMap>

    <select id="selectListView"
		resultType="com.cl.entity.view.AnlixinxiView" >

		SELECT  anlixinxi.* FROM anlixinxi  anlixinxi 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.cl.entity.view.AnlixinxiView" >
		SELECT * FROM anlixinxi  anlixinxi <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectGroupBy"
		resultType="com.cl.entity.view.AnlixinxiView" >
		select userid,username,paperid,papername,sum(myscore) myscore,ROUND(sum(case when myscore>0 then 1 else 0 end)/(sum(1)),2) accuracy from examrecord     
        <where> 1=1 ${ew.sqlSegment}</where>
        group by userid,username,paperid,papername  
	</select>

</mapper>
